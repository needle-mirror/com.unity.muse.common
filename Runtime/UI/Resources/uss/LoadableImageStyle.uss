.li-status-loading{
    flex-grow: 1;
    background-image: resource('spinner.png');
}

.li-element{
    overflow: hidden;
    background-color: var(--appui-backgrounds-100);
    flex-grow: 1;

    -unity-background-scale-mode: scale-to-fit;
}
#Buttons{
    flex-grow: 1;
}
#Buttons{
    opacity: 0;
    transition-duration: var(--anim-duration);
}
#Buttons:hover{
    opacity: 1;
    transition-duration: var(--anim-duration);
}

.unity-texture-genai-element-main > * > #Buttons{
    display: none;
}