:root{
    margin-top: var(--appui-spacing-100);
    flex-shrink: 0;
    border-radius: 12px; 
    background-color: rgba(0,0,0,0.5);
    padding: var(--appui-spacing-100);
    align-items: center;
    flex-direction: row;
    align-self: center;
}

IconButton {
    margin-left: var(--appui-spacing-100);
    margin-right: var(--appui-spacing-100);
}

.appui-actiongroup{
    flex-grow: 0;
    margin-right: var(--appui-spacing-50);
}

.appui-actiongroup > .appui-button{
    width: 42px;
}

.appui-actiongroup > .appui-button > .appui-button__trailingcontainer{
    margin-right: 0;
}

Button{
    border-width: 1px;
}

.muse-toolbar--selected{
    background-color: var(--appui-base-400);
}