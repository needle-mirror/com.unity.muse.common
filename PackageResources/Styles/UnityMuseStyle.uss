.appui-actionbutton__label {
    font-size: var(--appui-font-sizes-100);
}

.appui-link {
    font-size: var(--appui-font-sizes-100);
}

.appui-button--quiet:disabled,
.appui-button--quiet.unity-disabled {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.appui-dialog__buttongroup > .appui-checkbox > .appui-checkbox__box {
    margin-left: 0;
}

.unity-text-field__input * {
    cursor: var(--appui-alias-control-cursor-text);
}

.appui-grid-view__item {
    padding: var(--appui-sizing-25);
}

.unity-scroller--vertical {
    background-color: rgba(0,0,0,0);
    margin: var(--appui-sizing-60) 0;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    width: var(--appui-sizing-100);
    margin: 0 var(--appui-sizing-60) 0 var(--appui-sizing-25);
    border-radius: var(--appui-sizing-50);
}

.unity-scroller--horizontal .unity-base-slider__dragger {
    height: var(--appui-sizing-100);
    margin: var(--appui-sizing-25) 0 var(--appui-sizing-60) 0;
    border-radius: var(--appui-sizing-50);
    min-height: auto;
}

.unity-scroller .unity-base-slider__dragger,
.unity-scroller .unity-base-slider__dragger:enabled {
    background-color: var(--appui-primary-600);
}

.unity-scroller .unity-base-slider__dragger:hover,
.unity-scroller .unity-base-slider__dragger:hover:enabled {
    background-color: var(--appui-primary-800);
}

.bottom-gap {
    margin-bottom: var(--appui-spacing-125);
}

.right-gap {
    margin-right: var(--appui-spacing-125);
}

.row {
    flex-direction: row;
    align-self: stretch;
}

.muse-spacer {
    flex-grow: 1;
    flex-shrink: 1;
}

/* testing an image in the canvas */
.muse-current-image {
    top: 100px;
    left: 400px;
    width: 200px;
    height: 200px;
    background-color: red;
}

.appui-inputlabel--horizontal > .appui-inputlabel__label {
    padding-right: var(--appui-alias-control-gap-md);
}

.appui-inputlabel--horizontal > .appui-inputlabel__label {
    padding-right: var(--appui-alias-control-gap-md);
    flex-basis: initial;
}

.muse-dropzone {
    background-color: var(--appui-backgrounds-100);
    padding: var(--appui-alias-control-gap-lg);
    border-width: var(--appui-alias-control-border-width);
    border-color: var(--appui-alias-actions-border-color-default);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.muse-dropzone:hover,
.muse-dropzone.is-hovered {
    border-color: var(--appui-alias-actions-border-color-hover);
}

.muse-dropzone:focus,
.muse-dropzone.is-focused {
    border-color: var(--appui-accent-100);
}

.muse-dropzone__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.muse-dropzone__helper {
    justify-content: center;
    align-items: center;
}

.muse-dropzone__message {
    -unity-text-align: middle-center;
}

.muse-dropzone.accept-drag,
.muse-dropzone.accept-drag:hover,
.muse-dropzone.accept-drag.is-hovered,
.muse-dropzone.accept-drag:focus,
.muse-dropzone.accept-drag.is-focused {
    border-color: var(--appui-accent-100);
}

.muse-patterns-view {
    width: 212px;
    height: 230px;
}

.muse-patterns-view__item {
    position: relative;
    width: 100px;
    height: 100px;
    padding: 4px;
}

.muse-patterns-view__image {
    width: 100%;
    height: 100%;
    border-width: var(--appui-alias-control-border-width);
    border-color: rgba(0,0,0,0);
}

.appui-grid-view__item.is-selected .muse-patterns-view__image {
    border-color: var(--appui-accent-100);
}